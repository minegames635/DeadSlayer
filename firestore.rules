rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'nickname', 'wave', 'kills', 'time', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 20
        && request.resource.data.wave is int
        && request.resource.data.wave >= 0
        && request.resource.data.wave <= 100000
        && request.resource.data.kills is int
        && request.resource.data.kills >= 0
        && request.resource.data.kills <= 10000000
        && request.resource.data.time is int
        && request.resource.data.time >= 0
        && request.resource.data.time <= 31536000;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /saves/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['json', 'savedAt', 'updatedAt'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 200000
        && request.resource.data.savedAt is number;
      allow delete: if false;
    }
  }
}
