var Cheat = {
  on: false, open: false, mode: '', el: null, buf: [],
  v: { rate: 1, dmg: 1, psp: 1, size: 1, pspd: 1, espd: 1, multi: 0, ts: 1 },
  SEQ: ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'KeyB', 'KeyA'],
  F: [['rate', 'Скорость атаки ×', 0.01, 1e8], ['dmg', 'Урон ×', 0.01, 1e8], ['psp', 'Скорость снаряда ×', 0.05, 1e8], ['size', 'Размер снаряда ×', 0.05, 100],
    ['pspd', 'Скорость игрока ×', 0.05, 1e4], ['espd', 'Скорость монстров ×', 0, 1e3], ['multi', 'Доп. выстрелы +', 0, 1000], ['ts', 'Скорость игры (0.1–100)', 0.1, 100]],
  init: function () {
    var self = this;
    window.addEventListener('keydown', function (e) {
      if (e.code === 'Tab') { if (self.on && (G.state === 'menu' || G.state === 'play' || self.open)) { e.preventDefault(); self.toggle(); } return; }
      if (e.target && e.target.tagName === 'INPUT') return;
      self.buf.push(e.code); if (self.buf.length > 10) self.buf.shift();
      if (self.buf.join() === self.SEQ.join()) { self.buf = []; self.on = true; if (!self.open) self.toggle(); }
    }, true);
    var d = this.el = document.createElement('div');
    d.style.cssText = 'position:fixed;right:12px;top:12px;z-index:50;background:rgba(0,0,0,.9);color:#0f0;font:13px monospace;padding:12px;border:1px solid #0f0;display:none;max-height:94vh;overflow:auto;width:310px';
    document.body.appendChild(d);
    ['keydown', 'keyup'].forEach(function (n) { d.addEventListener(n, function (e) { e.stopPropagation(); }); });
    d.addEventListener('input', function (e) {
      var k = e.target.dataset.k, v = parseFloat(e.target.value); if (!k || isNaN(v)) return;
      var f = self.F.filter(function (x) { return x[0] === k; })[0];
      self.v[k] = Math.max(f[2], Math.min(f[3], v)); if (G.p && S.w) derive();
    });
    d.addEventListener('click', function (e) { var a = e.target.dataset.a; if (a) self.act(a); });
  },
  toggle: function () { if (this.open) this.close(); else this.show(); },
  show: function () {
    var h = '<b>CHEAT</b> (TAB — закрыть)<br><br>', self = this;
    if (G.state === 'menu') {
      this.mode = 'menu';
      h += 'Монеты: <input data-n="coins" type="number" step="any" value="' + Save.d.coins + '" style="width:120px"><br><br><button data-a="set">Установить</button> <button data-a="add">Добавить</button>';
    } else if (G.state === 'play') {
      this.mode = 'game'; G.state = 'cheat'; G.keys = {};
      this.F.forEach(function (f) { h += '<div style="display:flex;justify-content:space-between;margin:3px 0">' + f[1] + '<input data-k="' + f[0] + '" type="number" step="any" value="' + self.v[f[0]] + '" style="width:90px"></div>'; });
      h += '<br>Компаньоны: <input data-n="cnt" type="number" value="5" style="width:60px"><br><button data-a="wisp">+ Дух</button> <button data-a="wolf">+ Волк</button> <button data-a="clr">Убрать</button>';
      h += '<br><br><button data-a="skip">Пропустить волну</button> <button data-a="reset">Сброс</button>';
    } else return;
    this.el.innerHTML = h; this.el.style.display = 'block'; this.open = true;
  },
  close: function () {
    this.el.style.display = 'none'; this.open = false;
    if (this.mode === 'game' && G.state === 'cheat') { G.state = 'play'; if (G.p && S.w) derive(); }
  },
  num: function (n) { var i = this.el.querySelector('[data-n="' + n + '"]'); return i ? parseFloat(i.value) || 0 : 0; },
  act: function (a) {
    var i;
    if (a === 'set' || a === 'add') { var c = Math.max(0, Math.floor(this.num('coins'))); Save.d.coins = a === 'set' ? c : Save.d.coins + c; Save.save(); this.el.querySelector('[data-n="coins"]').value = Save.d.coins; }
    else if (a === 'wisp' || a === 'wolf') { var n = Math.max(0, Math.min(300, Math.floor(this.num('cnt')))); for (i = 0; i < n; i++) { G.minionTypes.push(a); addMinion(a); } }
    else if (a === 'clr') { G.minions.forEach(function (m) { World.scene.remove(m.g); }); G.minions = []; G.minionTypes = []; }
    else if (a === 'skip') {
      if (G.phase !== 'intro' && G.phase !== 'fight') return;
      G.phase = 'fight'; G.spawned = G.total; G.killedW = G.total;
      G.enemies.slice().forEach(function (e) { killEnemy(e, true); }); G.boss = null; this.close();
    } else if (a === 'reset') {
      this.v = { rate: 1, dmg: 1, psp: 1, size: 1, pspd: 1, espd: 1, multi: 0, ts: 1 };
      this.el.querySelectorAll('[data-k]').forEach(function (x) { x.value = Cheat.v[x.dataset.k]; }); if (G.p && S.w) derive();
    }
  }
};
Cheat.init();
